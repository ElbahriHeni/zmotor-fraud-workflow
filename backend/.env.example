PORT=5000
NODE_ENV=development

# =========================================================
# Current active database mode
# Keep this as postgres for now.
# Do NOT switch to mssql until server.js routes are converted.
# =========================================================
DB_TYPE=mssql

# =========================================================
# Current PostgreSQL / Neon database
# Keep your current Neon DATABASE_URL value here.
# Do not share it and do not push it to GitHub.
# =========================================================
DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@YOUR_HOST/YOUR_DATABASE?sslmode=require

# =========================================================
# Microsoft SQL Server - prepared for next conversion step
# SQL Server Express local instance
# =========================================================

MSSQL_HOST=localhost
MSSQL_PORT=14330
MSSQL_DATABASE=FraudManagementDB
MSSQL_USER=fraud_app_user
MSSQL_PASSWORD=FraudApp@12345!
MSSQL_ENCRYPT=false
MSSQL_TRUST_SERVER_CERTIFICATE=true

# Optional: not used when MSSQL_INSTANCE is used
# MSSQL_PORT=1433

# =========================================================
# Frontend URL for local development
# =========================================================
FRONTEND_URL=http://localhost:5173

# =========================================================
# Supabase - legacy / old document storage
# Keep only if your current backend still references Supabase.
# =========================================================
SUPABASE_URL=PASTE_YOUR_REAL_SUPABASE_URL_HERE
SUPABASE_SERVICE_ROLE_KEY=PASTE_YOUR_REAL_SUPABASE_SERVICE_ROLE_KEY_HERE
SUPABASE_BUCKET=fraud-documents

# =========================================================
# Authentication mode
# Use local for your current email/password login.
# =========================================================
AUTH_MODE=local

# Development fallback user - only used if AUTH_MODE=dev
DEV_USER_EMAIL=heni@demo.local
DEV_USER_NAME=Heni Elbahri

# Local JWT authentication
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters
JWT_EXPIRES_IN=8h

# Local user bootstrap
LOCAL_AUTH_BOOTSTRAP=true
LOCAL_AUTH_RESET_PASSWORDS=false
LOCAL_AUTH_USERS=admin@arabianshield.com|System Admin|admin|Admin@12345!;Al.Aldakhel@arabianshield.com|Al Aldakhel|user|ChangeMe@12345!

# =========================================================
# Future customer AD / Entra configuration
# Keep placeholders for now.
# Used only when AUTH_MODE=ad
# =========================================================
AD_TENANT_ID=
AD_CLIENT_ID=
AD_AUDIENCE=
AD_ALLOWED_GROUP_ID=

# =========================================================
# Read-only intelligent assistant
# rules: works locally without sending data to an external AI provider
# openai: enables natural-language tool calling through the OpenAI Responses API
# When openai is enabled, sanitized case tool results may be sent to the provider.
# =========================================================
ASSISTANT_PROVIDER=rules
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
ASSISTANT_TIMEOUT_MS=30000
ASSISTANT_RATE_LIMIT_MAX=40
